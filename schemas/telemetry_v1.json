{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermal.dev/schemas/telemetry_v1.json",
  "title": "THERMAL Telemetry Sample",
  "description": "A single point-in-time telemetry sample collected during a run. schema_version is immutable once records exist against it; changes require a new version.",
  "type": "object",
  "required": ["schema_version", "timestamp_ns", "monotonic_ns", "run_id", "cpu", "gpu", "process"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "timestamp_ns": {
      "type": "integer",
      "description": "Wall-clock UNIX time in nanoseconds, for correlating with external logs."
    },
    "monotonic_ns": {
      "type": "integer",
      "description": "time.monotonic_ns() at capture; the only clock safe for computing durations."
    },
    "run_id": { "type": "string", "format": "uuid" },
    "cpu": {
      "type": "object",
      "required": ["utilization_percent"],
      "additionalProperties": false,
      "properties": {
        "utilization_percent": { "type": ["number", "null"] },
        "per_core_utilization_percent": { "type": ["array", "null"], "items": { "type": "number" } },
        "load_average_1m": { "type": ["number", "null"] },
        "context_switches_per_sec": { "type": ["number", "null"] },
        "page_faults_per_sec": { "type": ["number", "null"] },
        "memory_used_mb": { "type": ["number", "null"] },
        "frequency_mhz": { "type": ["number", "null"] },
        "unavailable_counters": {
          "type": "array",
          "items": { "type": "object", "required": ["name", "reason"], "properties": { "name": { "type": "string" }, "reason": { "type": "string" } } }
        }
      }
    },
    "gpu": {
      "type": ["object", "null"],
      "description": "null when no GPU is present; a populated object never contains fabricated fields — any counter this backend cannot read is listed under unavailable_counters instead of being omitted silently.",
      "additionalProperties": false,
      "properties": {
        "device_index": { "type": "integer" },
        "utilization_percent": { "type": ["number", "null"] },
        "memory_utilization_percent": { "type": ["number", "null"] },
        "memory_used_mb": { "type": ["number", "null"] },
        "temperature_c": { "type": ["number", "null"] },
        "power_watts": { "type": ["number", "null"] },
        "sm_clock_mhz": { "type": ["number", "null"] },
        "memory_clock_mhz": { "type": ["number", "null"] },
        "pcie_tx_kbps": { "type": ["number", "null"] },
        "pcie_rx_kbps": { "type": ["number", "null"] },
        "fan_speed_percent": { "type": ["number", "null"] },
        "performance_state": { "type": ["integer", "null"] },
        "unavailable_counters": {
          "type": "array",
          "items": { "type": "object", "required": ["name", "reason"], "properties": { "name": { "type": "string" }, "reason": { "type": "string" } } }
        }
      }
    },
    "process": {
      "type": ["object", "null"],
      "description": "Per-process metrics for the workload subprocess being measured; null when sampling system-wide only.",
      "additionalProperties": false,
      "properties": {
        "pid": { "type": "integer" },
        "cpu_time_seconds": { "type": ["number", "null"] },
        "rss_mb": { "type": ["number", "null"] },
        "num_threads": { "type": ["integer", "null"] },
        "io_read_bytes": { "type": ["integer", "null"] },
        "io_write_bytes": { "type": ["integer", "null"] },
        "num_ctx_switches": { "type": ["integer", "null"] }
      }
    },
    "application": {
      "type": ["object", "null"],
      "description": "Workload-reported metrics (Phase 3+); null for pure hardware samples.",
      "additionalProperties": false,
      "properties": {
        "latency_ms": { "type": ["number", "null"] },
        "throughput": { "type": ["number", "null"] },
        "tokens_per_sec": { "type": ["number", "null"] },
        "batch_size": { "type": ["integer", "null"] },
        "queue_time_ms": { "type": ["number", "null"] }
      }
    }
  }
}
